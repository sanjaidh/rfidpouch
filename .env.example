# PouchTrack Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite fallback (runs immediately without PostgreSQL setup):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Render, Supabase, Neon, AWS RDS, etc.):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/pouchtrack?schema=public"

# CORS Allowed Origins (comma-separated or single)
CORS_ORIGIN="http://localhost:5173"

# Frontend API URL (for Vite build)
VITE_API_URL="http://localhost:5000"
